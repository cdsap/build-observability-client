{
  "name": "@cdsap/gbos",
  "version": "0.1.0",
  "description": "Source-neutral GBOS parsing, normalization, querying, and visualization planning",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdsap/build-observability-client.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "default": "./dist/assets/index.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./parse": {
      "types": "./dist/parse/index.d.ts",
      "default": "./dist/parse/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "default": "./dist/diagnostics/index.js"
    },
    "./adapters/source": { "types": "./dist/adapters/source.d.ts", "default": "./dist/adapters/source.js" },
    "./adapters/direct": { "types": "./dist/adapters/direct.d.ts", "default": "./dist/adapters/direct.js" },
    "./adapters/report": { "types": "./dist/adapters/report.d.ts", "default": "./dist/adapters/report.js" },
    "./adapters/ndjson": { "types": "./dist/adapters/ndjson.d.ts", "default": "./dist/adapters/ndjson.js" },
    "./adapters/develocity": {
      "types": "./dist/adapters/develocity.d.ts",
      "default": "./dist/adapters/develocity.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "default": "./dist/view.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "default": "./dist/presentation.js"
    },
    "./render-dom": {
      "types": "./dist/render/dom.d.ts",
      "default": "./dist/render/dom.js"
    },
    "./adapters/extension": {
      "types": "./dist/adapters/extension.d.ts",
      "default": "./dist/adapters/extension.js"
    },
    "./schema/*": "./schemas/schema/*",
    "./registry/*": "./schemas/registry/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "schemas"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "pack:verify": "npm run build && node scripts/verify-package.mjs",
    "browser:check": "npm run build && node scripts/verify-browser.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "release:check": "npm run check && npm test && npm run pack:verify && node scripts/verify-release.mjs",
    "assets:sync": "node scripts/sync-schema-assets.mjs",
    "assets:check": "node scripts/sync-schema-assets.mjs --check",
    "prepublishOnly": "npm run check && npm test && npm run browser:check && node scripts/verify-package.mjs && node scripts/verify-release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
